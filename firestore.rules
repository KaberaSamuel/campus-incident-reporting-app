rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn() && userDoc().data.role == 'staff';
    }

    function isStudent() {
      return signedIn() && userDoc().data.role == 'student';
    }

    function incidentCreateValid() {
      return request.resource.data.keys().hasAll([
          'reporterId', 'reporterName', 'category', 'title', 'description',
          'titleLowercase', 'locationId', 'locationName', 'status',
          'createdAt', 'updatedAt', 'statusHistory', 'imageUrls'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 3;
    }

    function staffIncidentUpdateValid() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'staffNote', 'updatedAt', 'statusHistory']);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['student', 'staff']
        && request.resource.data.keys().hasAll(['email', 'fullName', 'role', 'fcmTokens']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcmTokens', 'email', 'fullName']);
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if signedIn();
      allow create: if isStudent() && incidentCreateValid();
      allow update: if isStaff() && staffIncidentUpdateValid();
      allow delete: if isStaff()
        || (isStudent()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'submitted');
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /notifications/{notificationId} {
      // Addressed to one user, or shared by all staff (audience == 'staff').
      allow read: if signedIn()
        && (resource.data.get('userId', null) == request.auth.uid
          || (resource.data.get('audience', null) == 'staff' && isStaff()));

      allow update: if signedIn()
        && ((resource.data.get('userId', null) == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || (resource.data.get('audience', null) == 'staff' && isStaff()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])));

      allow create: if
        // Staff -> reporter, written together with a status/note update.
        (isStaff()
          && request.resource.data.keys().hasOnly(
            ['userId', 'type', 'title', 'body', 'incidentId', 'read', 'createdAt'])
          && request.resource.data.type in ['status_update', 'staff_note']
          && request.resource.data.read == false)
        // Student -> all staff, written together with a new incident.
        || (isStudent()
          && request.resource.data.keys().hasOnly(
            ['audience', 'type', 'title', 'body', 'incidentId', 'reporterId', 'readBy', 'createdAt'])
          && request.resource.data.audience == 'staff'
          && request.resource.data.type == 'new_incident'
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.readBy.size() == 0
          && getAfter(/databases/$(database)/documents/incidents/$(request.resource.data.incidentId))
              .data.reporterId == request.auth.uid);

      allow delete: if false;
    }
  }
}
